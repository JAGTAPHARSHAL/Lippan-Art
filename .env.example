# Set a long, unique password before exposing the studio admin.
ADMIN_PASSWORD=replace-this-with-a-long-random-password

# Razorpay Dashboard → Account & Settings → API Keys
# Start with test keys, then switch to live keys after activation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public URL, for example https://your-domain.example
PUBLIC_URL=http://localhost:3000
PORT=3000
